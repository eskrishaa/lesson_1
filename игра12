        if cmd in num_to_verb:
            verb = num_to_verb[cmd]

        match verb:
            case "look":
                print("Вы осмотрелись. Сруб колодца оброс мхом, на дне блестит вода.")

            case "go":
                cost = 2
                if stamina >= cost:
                    stamina -= cost
                    print("Вы осторожно идёте вперёд. Доски настила скрипят под ногами.")
                else:
                    health -= cost - stamina
                    stamina = 0
                    print("Сил больше нет — вы идёте на одном упорстве.")

            case "rest":
                stamina += 3
                print("Вы присели отдохнуть у сруба. Силы понемногу возвращаются.")

            case "listen":
                print("Вы заглядываете в колодец. В темноте ничего не видно, только холод тянет снизу.")

            case "torch":
                stamina += 1
                print("Вы зачерпнули воды и умылись. Свежесть придаёт сил.")

            case "train":
                strikes = 6
                total_damage = 0
                crit_count = 0

                print("Вы подходите к старому столбу у колодца.")
                print("Он стоит здесь с тех пор, как мельница ещё работала.")

                print()
                print(f"Наносите {strikes} ударов.")

                for i in range(1, strikes + 1):
                    hit_damage, crit = hero_hit(i)
                    if crit:
                        crit_count += 1
                        print(f"Удар {i}: {hit_damage:.1f} – критический!")
                    else:
                        print(f"Удар {i}: {hit_damage:.1f}")
                    total_damage += hit_damage

                print()
                print(f"Итог: {strikes} ударов, критических ударов: {crit_count}")
                print(f"Общий урон: {total_damage:.1f}")
                print(f"Средний урон: {total_damage / strikes:.1f}")

                stamina -= 3

            case "descend":
                if not enemies:
                    print("Вы спускаетесь вниз. Но подземелье пусто.")
                else:
                    enemy = random.choice(enemies)
                    rounds, won, health, loot = fight(enemy, health, bonus=ability_bonus)

                    for r in rounds:
                        log.append(r)

                    if won:
                        gold_total += loot
                        enemies.remove(enemy)
                        print(f"{enemy.capitalize()} повержен! Осталось врагов: {len(enemies)}. Добыча: {loot} золота.")

                    print(f"Бой: {len(rounds)} раундов.")

            case "leaders":
                print_leaderboard(log)

            case "shop":
                print("Магазин:")
                for name, price in prices.items():
                    print(f"{name}: {price} золота")

            case "backpack":
                print_backpack(inventory)

            case "buy":
                if len(words) > 1 and words[-1].isdigit():
                    qty = int(words[-1])
                    item = " ".join(words[1:-1])
                else:
                    qty = 1
                    item = " ".join(words[1:])

                if item == "":
                    print("Купить что? Введи: buy <предмет>.")
                    continue

                if item not in prices:
                    print("Такого предмета в магазине нет.")
                    continue

                gold_total, ok = buy(prices[item], gold_total, quantity=qty)

                if ok:
                    inventory[item] = inventory.get(item, 0) + qty

                    if item == "torch_oil":
                        stamina = min(stamina + 5 * qty, max_stamina)
                    elif item == "war_elixir":
                        ability_bonus += 2 * qty

                    print(f"Куплено {qty} шт. ({item}) за {prices[item] * qty} золота. Осталось: {gold_total}.")
                else:
                    print(f"Не хватает золота: нужно {prices[item] * qty}, есть {gold_total}.")

            case "drink":
                item = " ".join(words[1:]) or "potion"

                if inventory.get(item, 0) == 0:
                    print(f"В рюкзаке нет {item}.")
                else:
                    health = min(health + 10, max_health)
                    inventory[item] -= 1
                    if inventory[item] == 0:
                        del inventory[item]
                    print(f"Вы выпили {item}. Здоровье: {health}. Осталось: {inventory.get(item, 0)}.")

            case "help":
                print("Команды: " + ", ".join(commands) + ".")
                print("Номера 0–11 работают как раньше.")

            case "exit":
                print("Вы поднимаетесь обратно к свету. Подземелье остаётся позади.")
                outcome = "выход"
                running = False

            case _:
                print(f"Не понимаю команду: '{line.strip()}'. Введи 'help'.")
                continue

        if health <= 0:
            print(f"{hero_name} падает без сил. Подземелье забирает ещё одного искателя.")
            outcome = "гибель"
            running = False

        if running:
            actions += 1

        print()
        print(f"Здоровье: {health:5d}   Запас сил: {stamina:5d}   Врагов: {len(enemies):2d}   Золото: {gold_total:4d}")

except KeyboardInterrupt:
    print()
    print("Игрок прервал сеанс.")

finally:
    print()
    print(frame)
    if outcome == "гибель":
        print(f"Ты не дошёл, {hero_name}. Действий совершено: {actions}.")
    elif outcome == "выход":
        print(f"Забег окончен, {hero_name}. Действий совершено: {actions}.")
    else:
        print(f"Сеанс прерван, {hero_name}. Действий совершено: {actions}.")

    print_run_summary(log)

    if inventory:
        print("Осталось в рюкзаке:")
        for name, qty in inventory.items():
            print(f"{name}: {qty} шт.")
