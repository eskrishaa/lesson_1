import random
import os
import json
import dungeon

# --- Цвет: try-import с откатом ---

try:
    from colorama import Fore, Style, init
    init()
    COLOR = True
except ImportError:
    COLOR = False
    Fore = None
    Style = None

# --- Константы игры ---

title = "КОЛОДЕЦ У СТАРОЙ МЕЛЬНИЦЫ"
frame = "=" * 32

base_attack = 10

MAP = [
    ["#", "#", "#", "#", "#"],
    ["#", ".", ".", "#", "#"],
    ["#", ".", "#", ".", "#"],
    ["#", ".", "#", ".", "#"],
    ["#", "#", "S", ".", "#"],
]

DIRECTIONS = {"north": (-1, 0), "south": (1, 0), "west": (0, -1), "east": (0, 1)}

hero_r, hero_c = 4, 2
visited = {(4, 2)}

LOOT = {
    (1, 1): "old coin",
    (2, 3): "dusty potion",
    (3, 3): "guard's gem",
}
found_loot = set()

enemies = list(dungeon.enemy_stats.keys())

log = []
inventory = {}

num_to_verb = {
    "1": "look", "2": "go", "3": "rest", "4": "listen", "5": "torch",
    "6": "train", "7": "descend", "8": "leaders", "9": "shop",
    "10": "backpack", "11": "drink", "0": "exit",
}

commands = [
    "look", "go", "rest", "listen", "torch", "train", "descend",
    "leaders", "shop", "backpack", "drink potion",
    "buy <item> [count]", "map", "scout", "newgame", "exit",
]

MENU = [
    "Что делаешь? (номер или команда; help для справки)",
    "1 - осмотреться (look)",
    "2 - идти вперёд (go)",
    "3 - отдохнуть (rest)",
    "4 - заглянуть в колодец (listen)",
    "5 - зачерпнуть воды (torch)",
    "6 - тренировка (train)",
    "7 - искать врага (descend)",
    "8 - таблица лидеров (leaders)",
    "9 - магазин (shop)",
    "10 - рюкзак (backpack)",
    "11 - выпить зелье (drink)",
    "0 - выйти из подземелья (exit)",
]

# --- Функции сюжета ---


def write_save():
    """Сохраняет состояние забега в save.json."""
    save = {}
    save["hero"] = hero_name
    save["health"] = health
    save["max_health"] = max_health
    save["stamina"] = stamina
    save["max_stamina"] = max_stamina
    save["strength"] = strength
    save["agility"] = agility
    save["luck"] = luck
    save["damage"] = damage
    save["crit_damage"] = crit_damage
    save["gold"] = gold_total
    save["bonus"] = ability_bonus
    save["actions"] = actions
    save["log"] = log
    save["inventory"] = inventory
    save["enemies"] = enemies
    save["position"] = [hero_r, hero_c]
    save["visited"] = [list(p) for p in visited]
    save["loot"] = sorted(found_loot)

    with open("save.json", "w", encoding="utf-8") as f:
        json.dump(save, f, ensure_ascii=False, indent=2)


def load_save():
    """Загружает сохранение. Возвращает словарь или None."""
    with open("save.json", encoding="utf-8") as f:
        return json.load(f)


def scout(r, c, seen):
    """Рекурсивный обход карты. Возвращает число комнат."""
    if (r, c) in seen or MAP[r][c] == "#":
        return 0
    seen.add((r, c))
    total = 1
    for dr, dc in DIRECTIONS.values():
        total += scout(r + dr, c + dc, seen)
    return total


def print_leaderboard(log):
    """Печатает топ-3 и рекорд врага."""
    if not log:
        print("Вы ещё не сражались.")
        return
    top = sorted(log, key=lambda r: r[1], reverse=True)[:3]
    print("Таблица лидеров (урон героя):")
    for i in range(len(top)):
        print(f"{i + 1}. Раунд {top[i][0]}: {top[i][1]:.1f}")
    worst = max(log, key=lambda r: r[2])
    print(f"Сильнейший удар врага: {worst[2]} (раунд {worst[0]}).")


def print_run_summary(log):
    """Печатает итог забега."""
    total = sum(r[1] for r in log)
    rounds = len(log)
    if rounds > 0:
        print(f"Урон: {total:.1f} за {rounds} раундов, в среднем {total / rounds:.1f}.")
    else:
        print("В этом забеге боёв не было.")


def print_backpack(inventory):
    """Печатает рюкзак."""
    if not inventory:
        print("Рюкзак пуст.")
    else:
        print("Рюкзак:")
        for name, qty in inventory.items():
            print(f"{name}: {qty} шт.")


def print_map():
    """Печатает карту с героем."""
    print("Карта:")
    for i in range(len(MAP)):
        cells = []
        for j in range(len(MAP[i])):
            cell = "@" if (i, j) == (hero_r, hero_c) else MAP[i][j]
            cells.append(cell)
        print(" ".join(cells))


# --- Заголовок ---

print(frame)
print(" " + title + " ")
print(frame)

print()

# --- Загрузка сохранения ---

loaded = None
if os.path.exists("save.json"):
    print("Найдено сохранение. Продолжить забег? (yes/no)")
    answer = input().strip().lower()
    if answer == "yes":
        try:
            loaded = load_save()
        except json.JSONDecodeError:
            print("Сохранение повреждено. Начинаем новый забег.")
            loaded = None

# --- Знакомство и настройка, если не продолжаем ---

if loaded is None:
    print("Как зовут героя?")
    hero_name = input()

    print(f"Добро пожаловать, {hero_name}!")
    print("Ты подходишь к колодцу у старой мельницы. Крыша провалилась, сруб почернел, из глубины тянет холодом.")

    print()

    print("Настройка героя.")
    print("Здоровье, сила, ловкость, удача – по одному числу в строке:")

    while True:
        try:
            health = int(input())
            strength = int(input())
            agility = int(input())
            luck = int(input())

            if health <= 0:
                raise ValueError(f"Здоровье должно быть положительным, вы ввели {health}")
            if strength < 0 or agility < 0 or luck < 0:
                raise ValueError("Характеристики не могут быть отрицательными")

            break
        except ValueError as e:
            print(f"{e}. Введите все четыре снова:")

    damage = base_attack + strength * 1.5
    crit_damage = damage * 2
    stamina = agility + luck // 2

    max_health = health
    max_stamina = stamina

    gold_total = 0
    ability_bonus = 0
    actions = 0
    log = []
    inventory = {}
    enemies = list(dungeon.enemy_stats.keys())
    hero_r, hero_c = 4, 2
    visited = {(4, 2)}
    found_loot = set()

    print("Характеристики героя:")
    print(f"Здоровье: {health}")
    print(f"Сила: {strength}")
    print(f"Ловкость: {agility}")
    print(f"Удача: {luck}")

    print()

    print(f"Урон героя: {damage:.1f}")
    print(f"Критический урон: {crit_damage:.1f}")
    print(f"Запас сил: {stamina}")

    print()

else:
    hero_name = loaded["hero"]
    health = loaded["health"]
    max_health = loaded["max_health"]
    stamina = loaded["stamina"]
    max_stamina = loaded["max_stamina"]
    strength = loaded["strength"]
    agility = loaded["agility"]
    luck = loaded["luck"]
    damage = loaded["damage"]
    crit_damage = loaded["crit_damage"]
    gold_total = loaded["gold"]
    ability_bonus = loaded["bonus"]
    actions = loaded["actions"]
    log = loaded["log"]
    inventory = loaded["inventory"]
    enemies = loaded["enemies"]
    hero_r, hero_c = loaded["position"]
    visited = {tuple(p) for p in loaded["visited"]}
    found_loot = set(loaded["loot"])

    print(f"Забег продолжен: здоровье {health}, золото {gold_total}, врагов {len(enemies)}.")
    print()

# --- Главный цикл ---

running = True
outcome = "прерывание"

try:
    while running:
        print("\n".join(MENU))
        print()

        line = input()
        cmd = line.strip().lower()
        while cmd == "":
            print("Пустая команда. Введи команду или номер.")
            line = input()
            cmd = line.strip().lower()

        words = cmd.split()

        if cmd in num_to_verb:
            verb = num_to_verb[cmd]
        else:
            verb = words[0]

        match verb:
            case "look":
                print("Вы осмотрелись. Сруб колодца оброс мхом, на дне блестит вода.")

            case "go":
                if len(words) > 1 and words[1] in DIRECTIONS:
                    dr, dc = DIRECTIONS[words[1]]
                    nr, nc = hero_r + dr, hero_c + dc

                    if 0 <= nr < len(MAP) and 0 <= nc < len(MAP[nr]) and MAP[nr][nc] != "#":
                        hero_r, hero_c = nr, nc
                        visited.add((hero_r, hero_c))

                        if (hero_r, hero_c) in LOOT:
                            item = LOOT[(hero_r, hero_c)]
                            if item not in found_loot:
                                found_loot.add(item)
                                print(f"Вы нашли {item}! Уникальных находок: {len(found_loot)}.")

                        print(f"Вы шагаете {words[1]}. Комната ({hero_r}, {hero_c}).")
                    else:
                        print(f"Нельзя идти {words[1]}: стена или край карты.")
                else:
                    cost = 2
                    if stamina >= cost:
                        stamina -= cost
                        print("Вы осторожно идёте вперёд. Доски настила скрипят под ногами.")
                    else:
                        health -= cost - stamina
                        stamina = 0
                        print("Сил больше нет — вы идёте на одном упорстве.")

            case "rest":
                stamina += 3
                print("Вы присели отдохнуть у сруба. Силы понемногу возвращаются.")

            case "listen":
                print("Вы заглядываете в колодец. В темноте ничего не видно, только холод тянет снизу.")

            case "torch":
                stamina += 1
                print("Вы зачерпнули воды и умылись. Свежесть придаёт сил.")

            case "train":
                strikes = 6
                total_damage = 0
                crit_count = 0

                print("Вы подходите к старому столбу у колодца.")
                print("Он стоит здесь с тех пор, как мельница ещё работала.")

                print()
                print(f"Наносите {strikes} ударов.")

                for i in range(1, strikes + 1):
                    hit_damage, crit = dungeon.hero_hit(i, damage, crit_damage)
                    if crit:
                        crit_count += 1
                        print(f"Удар {i}: {hit_damage:.1f} – критический!")
                    else:
                        print(f"Удар {i}: {hit_damage:.1f}")
                    total_damage += hit_damage

                print()
                print(f"Итог: {strikes} ударов, критических ударов: {crit_count}")
                print(f"Общий урон: {total_damage:.1f}")
                print(f"Средний урон: {total_damage / strikes:.1f}")

                stamina -= 3

            case "descend":
                if not enemies:
                    print("Вы спускаетесь вниз. Но подземелье пусто.")
                else:
                    enemy = random.choice(enemies)
                    rounds, won, health, loot = dungeon.fight(
                        enemy, health, ability_bonus, damage, crit_damage
                    )

                    for r in rounds:
                        log.append(r)

                    if won:
                        gold_total += loot
                        enemies.remove(enemy)
                        win_msg = f"{enemy.capitalize()} повержен! Осталось врагов: {len(enemies)}. Добыча: {loot} золота."
                        if COLOR:
                            print(Fore.YELLOW + win_msg + Style.RESET_ALL)
                        else:
                            print(win_msg)

                    print(f"Бой: {len(rounds)} раундов.")

            case "leaders":
                print_leaderboard(log)

            case "shop":
                print("Магазин:")
                for name, price in dungeon.prices.items():
                    print(f"{name}: {price} золота")

            case "backpack":
                print_backpack(inventory)

            case "drink":
                item = " ".join(words[1:]) or "potion"
                if inventory.get(item, 0) == 0:
                    print(f"В рюкзаке нет {item}.")
                else:
                    health = min(health + 10, max_health)
                    inventory[item] -= 1
                    if inventory[item] == 0:
                        del inventory[item]
                    print(f"Вы выпили {item}. Здоровье: {health}. Осталось: {inventory.get(item, 0)}.")

            case "buy":
                if len(words) > 1 and words[-1].isdigit():
                    qty = int(words[-1])
                    item = " ".join(words[1:-1])
                else:
                    qty = 1
                    item = " ".join(words[1:])

                if item == "":
                    print("Купить что? Напиши: buy <item>.")
                    continue
                if item not in dungeon.prices:
                    print("Такого предмета в магазине нет.")
                    continue

                gold_total, ok = dungeon.buy(dungeon.prices[item], gold_total, quantity=qty)
                if ok:
                    inventory[item] = inventory.get(item, 0) + qty
                    if item == "torch_oil":
                        stamina = min(stamina + 5 * qty, max_stamina)
                    elif item == "war_elixir":
                        ability_bonus += 2 * qty
                    print(f"Куплено {qty} шт. ({item}) за {dungeon.prices[item] * qty} золота. Осталось: {gold_total}.")
                else:
                    print(f"Не хватает золота: нужно {dungeon.prices[item] * qty}, есть {gold_total}.")

            case "map":
                print_map()

            case "scout":
                seen = set()
                rooms = scout(hero_r, hero_c, seen)
                print(f"Разведка: доступно комнат — {rooms}.")

            case "newgame":
                if os.path.exists("save.json"):
                    os.remove("save.json")
                    print("Сохранение уничтожено. Следующий забег начнётся с чистого листа.")
                else:
                    print("Нет сохранения для уничтожения.")
                continue

            case "help":
                print("Команды: " + ", ".join(commands) + ".")
                print("Номера 0–11 работают как раньше.")

            case "exit":
                print("Вы поднимаетесь обратно к свету. Подземелье остаётся позади.")
                write_save()
                print("Прогресс сохранён.")
                outcome = "выход"
                running = False

            case _:
                print(f"Не понимаю команду: '{line.strip()}'. Введи 'help'.")
                continue

        if health <= 0:
            print(f"{hero_name} падает без сил. Подземелье забирает ещё одного искателя.")
            if os.path.exists("save.json"):
                os.remove("save.json")
            outcome = "гибель"
            running = False

        if running:
            actions += 1

        print()
        state = f"Здоровье: {health:5d}   Запас сил: {stamina:5d}   Врагов: {len(enemies):2d}   Золото: {gold_total:4d}"
        if COLOR:
            print(Fore.GREEN + state + Style.RESET_ALL)
        else:
            print(state)

except KeyboardInterrupt:
    print()
    print("Игрок прервал сеанс.")
    write_save()
    print("Прогресс сохранён.")

finally:
    print()
    print(frame)
    if outcome == "гибель":
        print(f"Ты не дошёл, {hero_name}. Действий совершено: {actions}.")
    elif outcome == "выход":
        print(f"Забег окончен, {hero_name}. Действий совершено: {actions}.")
    else:
        print(f"Сеанс прерван, {hero_name}. Действий совершено: {actions}.")

    print_run_summary(log)

    if inventory:
        print("Осталось в рюкзаке:")
        for name, qty in inventory.items():
            print(f"{name}: {qty} шт.")
    else:
        print("Осталось в рюкзаке: ничего.")

    print(frame)
